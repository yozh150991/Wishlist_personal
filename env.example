# Фронтенд (app/.env.local)
# Значення беруться з дашборду Supabase: кнопка Connect, або Settings → API Keys.
# project-ref видно в адресному рядку: supabase.com/dashboard/project/<project-ref>
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
VITE_PARSER_URL=https://parser.<your-domain>
VITE_PUBLIC_ORIGIN=https://wishlist.<your-domain>

# Парсер (services/parser/.env)
# Парсеру НЕ потрібен жоден ключ Supabase — він лише перевіряє підпис JWT
# через публічний JWKS. Секретний ключ сюди не додавати ніколи (ADR-012).
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PROJECT_REF=<project-ref>
PARSER_ALLOWED_ORIGINS=https://wishlist.<your-domain>,http://localhost:5173
PARSER_MAX_BYTES=2097152
PARSER_TIMEOUT_SECONDS=8
PARSER_RATE_LIMIT_PER_MIN=20
PARSER_CACHE_TTL_SECONDS=900
