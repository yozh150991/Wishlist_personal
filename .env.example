# Фронтенд (app/.env.local)
# Значення беруться з дашборду Supabase: кнопка Connect, або Settings → API Keys.
# project-ref видно в адресному рядку: supabase.com/dashboard/project/<project-ref>
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
# Адреса для спільних посилань. Зазвичай не потрібна: без неї береться
# адреса з браузера. Не розкоментовуй із шаблоном — посилання гостям вестимуть у нікуди.
# VITE_PUBLIC_ORIGIN=https://<your-address>
# Без цієї змінної кнопка «Заповнити» у формі позиції неактивна,
# а поля заповнюються вручну.
# Локально: http://localhost:8787 (див. PARSER_HOST_PORT нижче)
# Бойовий: https://wishlist-parser-<...>.europe-central2.run.app
VITE_PARSER_URL=http://localhost:8787
# Вхід через Google на екранах v2 (DEPLOY.md, розділ 4.1). Лише після того,
# як провайдер Google увімкнено в Supabase — інакше кнопка веде на помилку.
# VITE_AUTH_GOOGLE=1
# Публічний ключ VAPID для push-сповіщень (ADR-049; DEPLOY.md, 9.9 і 9.11).
# Не секрет. Без нього push у застосунку прихований, лишаються листи.
# Локально зазвичай не потрібен: Service Worker у режимі розробки вимкнено.
# VITE_VAPID_PUBLIC_KEY=B<...>

# Локальна база (app/.env.localdb.local, запуск: npm run dev:local)
# Режим localdb перекриває .env.local, тож бойові значення можна не чіпати.
# URL і ключ показує `npx supabase status` (Publishable key або anon key).
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=<ключ із supabase status>
# Бойовий парсер не прийме токен локальної бази — кнопку «Заповнити» вимикаємо.
# VITE_PARSER_URL=

# Парсер (services/parser/.env)
# Секретів тут немає і бути не може (ADR-012). Publishable-ключ публічний,
# він потрібен лише як apikey при перевірці токена в Supabase (ADR-018).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
PARSER_ALLOWED_ORIGINS=http://localhost:5173
# Сторінка понад цей розмір не відхиляється, а обрізається:
# мета-теги лежать у <head>, тобто на початку.
PARSER_MAX_BYTES=5242880
PARSER_TIMEOUT_SECONDS=8
PARSER_RATE_LIMIT_PER_MIN=20
PARSER_CACHE_TTL_SECONDS=900
PARSER_TOKEN_CACHE_SECONDS=300
PARSER_MAX_REDIRECTS=5
# Порт на хості. Змінюй, якщо він зайнятий або зарезервований системою.
# Усередині контейнера сервіс завжди слухає 8080.
PARSER_HOST_PORT=8787

# Фонові задачі wishlist-jobs (ADR-048) — окремий закритий сервіс Cloud Run
# із того самого коду парсера (DEPLOY.md, розділ 9). У бою змінні задає
# `gcloud run deploy`, а ключ приходить із Secret Manager. НІКОЛИ не клади
# SUPABASE_SECRET_KEY у .env парсера: відкритий парсер ключа бази не тримає
# (ADR-012), і /health парсера покаже "secret_key_present": true.
# Локально сервіс задач не запускаємо: база одна й бойова (CLAUDE.md §6),
# логіку покривають тести з підмінною базою (services/parser/tests/test_jobs.py).
# APP_MODULE=app.jobs_main:app
# SUPABASE_SECRET_KEY=sb_secret_<...>
# Сповіщення (ADR-049): ключі — теж лише з Secret Manager, адреси — змінні.
# BREVO_API_KEY=xkeysib-<...>
# VAPID_PRIVATE_KEY=<43 символи base64url>
# MAIL_FROM=<підтверджена в Brevo адреса відправника>
# APP_ORIGIN=https://<your-address>
# JOBS_BATCH_SIZE=50
# JOBS_TIME_BUDGET_SECONDS=300
# JOBS_RECHECK_HOURS=20
# JOBS_HOST_DELAY_SECONDS=2
# JOBS_CONCURRENCY=4
