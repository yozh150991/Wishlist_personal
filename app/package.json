{
  "name": "wishlist-personal-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode localdb",
    "env:local": "node scripts/env-local.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:e2e": "playwright test",
    "gen:types": "supabase gen types typescript --linked > src/types/database.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@supabase/supabase-js": "^2.50.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
